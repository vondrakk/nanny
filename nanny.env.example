# nanny.env — copy to nanny.env and fill in.
#
# IMPORTANT: this file is read by `podman --env-file`, which does NOT support
# inline comments. Everything after `=` is the literal value. Keep comments on
# their own lines (like these); never put a comment after a value.
# Keep the real nanny.env out of version control.

# ── Anthropic (shell, run, server triage, selftest) ──
ANTHROPIC_API_KEY=

# ── Icinga (fleet source of truth) ──
# nanny inventories the fleet and reads live host/service state from the Icinga2
# REST API instead of scanning the network. Set the URL and `discover` + the
# fleet view use Icinga automatically.
# base URL incl. port, e.g. https://icinga.yourco.net:5665
ICINGA_API_URL=
# an Icinga2 API user (conf.d/api-users.conf) with read permission on objects
ICINGA_API_USER=
ICINGA_API_PASSWORD=
# optional: path to the CA bundle that signed Icinga's API cert
# ICINGA_API_CA=/run/secrets/icinga_ca.crt
# optional: skip TLS verification (Icinga's API cert is self-signed by default)
# ICINGA_INSECURE=true
# optional: lower the TLS floor (min TLSv1, cipher SECLEVEL 0) for ancient Icinga
# (≤2.x) whose old cert/cipher a modern OpenSSL would otherwise refuse. Leave unset
# for modern Icinga so it keeps a strong TLS floor.
# ICINGA_LEGACY_TLS=true
# optional: retries for transient connection failures (default 4). Bump it if the
# path to Icinga is flaky (e.g. rootless container over a VPN); auth errors aren't retried.
# ICINGA_RETRIES=6

# ── Slack ──
# xoxb-... bot token; used to post triage/incident/report updates
SLACK_BOT_TOKEN=
# channel id for nanny's investigating/page/recovery posts
SLACK_ALERT_CHANNEL=
# xapp-... app-level token; only needed for `run` (Socket Mode)
SLACK_APP_TOKEN=
# only needed for `run` (the Slack PagerDuty watcher)
PAGERDUTY_SLACK_BOT_ID=
# Slack app signing secret — enables INTERACTIVE incident cards: nanny posts a
# Block Kit card with Claim/Ack/Release buttons and updates it in place. Set the
# app's Interactivity Request URL to  https://<nanny-host>/slack/interactive .
# When set, incident lifecycle posts render as one updating card instead of text.
SLACK_SIGNING_SECRET=

# ── Atlassian: shared Confluence + Jira (Cloud) ──
ATLASSIAN_EMAIL=
# from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=https://yourco.atlassian.net
CONFLUENCE_BASE_URL=https://yourco.atlassian.net/wiki

# ── Jira write path (incident tickets created by `server`) ──
# project new incident tickets land in, e.g. OPS
JIRA_PROJECT_KEY=
# issue type; must exist in that project (Task | Incident | Bug)
JIRA_ISSUE_TYPE=Task
# optional: target status when auto-closing (looked up per issue)
# JIRA_DONE_STATUS=Done
# optional: explicit transition id, skips the status lookup
# JIRA_DONE_TRANSITION_ID=
# optional: set to false to keep self-resolved tickets open
# NANNY_AUTOCLOSE=true

# ── PagerDuty ──
# REST API key; used by run/shell to ACK incidents
PAGERDUTY_API_TOKEN=
# a real PD user with permission to ack; required header
PAGERDUTY_FROM_EMAIL=
# Events API v2 key; server/monitor page with this
PAGERDUTY_ROUTING_KEY=
# optional: api.eu.pagerduty.com for EU accounts
# PAGERDUTY_API_BASE=https://api.pagerduty.com

# ── ntfy (push notifications; the demo's Slack/PagerDuty stand-in) ──
# A free, no-account push channel (https://ntfy.sh). Set a topic to turn it on —
# status updates and pages are published there; subscribe from the ntfy app/browser.
# Fires even in dry-run, so it's the channel `nanny demo` uses end-to-end. No-op
# unless a topic is set, so it never interferes with a real Slack/PagerDuty setup.
# NANNY_NTFY_TOPIC=my-unique-nanny-topic
# server (point at a self-hosted ntfy to stay fully offline)
# NANNY_NTFY_URL=https://ntfy.sh
# bearer token, only for access-controlled topics
# NANNY_NTFY_TOKEN=
# enables tap-to-Ack/Claim buttons on pages: the URL a SUBSCRIBER'S DEVICE can reach
# nanny at (LAN IP / tunnel, not localhost). Needs NANNY_DEMO mode (seeds the token).
# NANNY_PUBLIC_URL=http://192.168.1.50:9099

# ── Demo mode (`nanny demo`) ──
# Self-contained showcase: synthetic incidents + ntfy, no real integrations. Sets safe
# defaults (dry-run, no-LLM triage, password 'demo', a generated ntfy topic) — all
# overridable. These only matter under `demo`:
# NANNY_DEMO_SCENARIO=true     # the self-running incident timeline (false = manual only)
# NANNY_DEMO_SPEED=1           # wall-clock multiplier for the arc (>1 slower, e.g. 3 ≈ 100s; clamped 0.25–12)
# NANNY_DEMO_LOOP_PAUSE=30     # seconds between scenario passes
# NANNY_DEMO_START_DELAY=8     # grace period before the first injection

# ── Runtime ──
# the bundle image already sets NANNY_DATA_DIR=/data; only set this if running
# outside the bundle and you want a different writable dir
# NANNY_DATA_DIR=/data
# port the server listens on (web console + webhook + API)
# NANNY_SERVER_PORT=9099

# ── Webhook authentication (Alertmanager /alert + Icinga /icinga) ──
# Shared secret the webhook senders must present, else any network peer can forge
# pages and open tickets. If unset, webhooks are open (logged loudly at startup).
# NANNY_WEBHOOK_TOKEN=change-me-long-random
# Senders authenticate with ANY of:
#   - Alertmanager: http_config.authorization { type: Bearer, credentials: <token> }
#   - Icinga notification curl:  -H "X-Nanny-Token: <token>"
#   - HMAC (strongest):  -H "X-Nanny-Signature: sha256=$(printf %s "$BODY" |
#                            openssl dgst -sha256 -hmac "<token>" | awk '{print $2}')"

# ── Log forwarding (observability / SIEM / Kubernetes) ──
# Emit every activity-log line (incl. the tool-use AUDIT trail) as structured JSON
# to stdout — the cloud-native path; OpenShift/Vector/Fluentd collect pod stdout.
# NANNY_LOG_JSON=true
# Optional: also fan out to a syslog collector (RFC5424 over UDP) for a SIEM.
# NANNY_LOG_SYSLOG=syslog.internal:514

# ── Control panel (operators connect to the server) ──
# where `panel` connects, e.g. http://nanny-host:9099
# NANNY_SERVER_URL=
# operator display name for `panel` (else prompted)
# NANNY_OPERATOR=

# ── Web console authentication ──
# A session is ALWAYS required to use the console/API; the mode below decides what
# credential proves identity. Sessions are 256-bit bearer tokens sent in the
# Authorization header (never the URL), expiring after 30 min idle / 12 h absolute.
# Pick ONE mode:
#   1. LDAP/AD bind  → set NANNY_LDAP_URL (see below). Strongest.
#   2. Shared console password → operators log in with a name + this password:
# NANNY_AUTH_PASSWORD=change-me-long-random
#   3. Name-only (NO password) → INSECURE, must be opted into explicitly. Anyone who
#      can reach the port can mint a session — keep strictly behind your VPN:
# NANNY_AUTH_INSECURE=false
# With none of the above set, logins are refused (fail closed).

# ── …mode 1: LDAP / Active Directory ──
# Set NANNY_LDAP_URL to require every operator to bind with their directory
# credentials before the console issues a session. Requires `ldap3` on the host.
# NANNY_LDAP_URL=ldaps://ldap.corp.example.net
# How to form the bind DN from the typed username. Pick ONE:
#   AD UPN style — username becomes user@domain:
# NANNY_LDAP_DOMAIN=corp.example.net
#   …or a DN template ({user} is substituted):
# NANNY_LDAP_BIND_DN_TEMPLATE=uid={user},ou=people,dc=corp,dc=example,dc=net
# Optional: look up display name + enforce group membership after the bind
# NANNY_LDAP_BASE_DN=dc=corp,dc=example,dc=net
# NANNY_LDAP_LOGIN_ATTR=sAMAccountName        # uid for OpenLDAP
# NANNY_LDAP_GROUP=oncall                      # substring-matched against memberOf
# Optional TLS knobs
# NANNY_LDAP_STARTTLS=false                     # StartTLS on a plain ldap:// connection
# NANNY_LDAP_INSECURE=false                     # skip cert validation (self-signed)
# NANNY_LDAP_LEGACY_TLS=false                   # old directory cert/cipher (TLS_CLIENT + SECLEVEL 0)
# NANNY_LDAP_RETRIES=2                           # retry transient connect failures (not bad passwords)
#
# Worked example — DomainTools OpenLDAP over LDAPS (translated from a Superset
# AUTH_LDAP_* block; note nanny uses NANNY_LDAP_*, not AUTH_LDAP_*):
# NANNY_LDAP_URL=ldaps://ldap.lb.domaintools.net:636
# NANNY_LDAP_BIND_DN_TEMPLATE=uid={user},ou=people,dc=domaintools,dc=net
# NANNY_LDAP_BASE_DN=dc=domaintools,dc=net
# NANNY_LDAP_LOGIN_ATTR=uid
# NANNY_LDAP_INSECURE=true      # internal cert not in the public trust store
# NANNY_LDAP_LEGACY_TLS=true    # OpenSSL 3 otherwise rejects the old cert
# (if DNS can't resolve the LDAP host inside the container, add
#  --add-host ldap.lb.domaintools.net:<ip> to the podman run, like Icinga.)

# ── LLM backend ──
# default is the Anthropic API (cloud, needs ANTHROPIC_API_KEY). Three choices:
#   anthropic           cloud Claude (default)
#   local               any OpenAI-compatible server (Ollama / vLLM / llama.cpp)
#   none                NO LLM — deterministic triage, zero token cost (see below)
# NANNY_LLM_BACKEND=local
# NANNY_LLM_BASE_URL=http://host.containers.internal:11434/v1
# NANNY_LLM_MODEL=llama3.1
# NANNY_LLM_API_KEY=local
#
# No-LLM mode (NANNY_LLM_BACKEND=none): nanny still opens tickets, holds, and pages,
# but instead of an LLM reasoning over the alert it gathers evidence directly —
# live Icinga state, the runbook (notes_url + Confluence search), prior Jira
# incidents, and self-resolve history — and writes that onto the ticket. No model,
# no API key, no per-incident token cost. (Distinct from NANNY_DRY_RUN, which
# simulates everything and suppresses real side effects.)
# NANNY_LLM_BACKEND=none
